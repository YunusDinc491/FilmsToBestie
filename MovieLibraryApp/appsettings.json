{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=MovieLibraryDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Omdb": {
    "ApiKey": "YOUR_OMDB_API_KEY"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "MovieLibraryApp",
    "Audience": "MovieLibraryAppUsers"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
